# Copy to ~/.config/gws-audit/gws-audit.env (or point GWS_AUDIT_ENV at another file) and adjust.
# A gws-audit.env in a cloned repo's root also works (it's git-ignored). Every value is optional.
# tools/pull.sh sources this file; tools/*.py read the same variables from the environment.

# GAM executable. Default: `gam` on PATH. Git Bash on Windows example: /c/GAM7/gam.exe
#GAM=gam

# GAM config folder (holds oauth2.txt, oauth2service.json). GAM's own variable.
#GAMCFGDIR=$HOME/.gam

# Where dated snapshots go. Keep it outside git and outside synced folders (OneDrive, Dropbox).
#GWS_AUDIT_OUT=$HOME/gws-audit-snapshots

# Workspace edition, used for edition-aware notes: starter | standard | plus | enterprise | unknown
#GWS_EDITION=unknown

# Isolated gcloud config folder used only for signJwt (see docs/setup.md, step 6).
#GWS_GCLOUD_CONFIG=$HOME/.gam/gcloud

# Service account used for domain-wide delegation.
# Default: client_email in $GAMCFGDIR/oauth2service.json
#GWS_SA_EMAIL=gam-project-xxxxx@gam-project-xxxxx.iam.gserviceaccount.com

# Extra domains to treat as internal for Drive sharing (comma separated).
# Domains and aliases from the snapshot's domains.csv / domainaliases.csv are always internal.
#GWS_INTERNAL_DOMAINS=example.org,example.net

# Python interpreter. Default: python3, falling back to python.
#PYTHON=python3
